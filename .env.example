# Reference for every key expected in .env.sops.yaml.
# This file documents the shape only — it contains no real value and is the one
# env file that belongs in Git. Generate the real thing with:
#
#   scripts/secrets.sh init <public-hostname>
#   scripts/secrets.sh edit

# --- Critical -----------------------------------------------------------
# 32 bytes of hex. Encrypts every credential stored by n8n.
# Losing it makes all credentials unrecoverable. Back it up OFFLINE, separately
# from this repository, and never regenerate it on a live instance.
N8N_ENCRYPTION_KEY=

# --- PostgreSQL ---------------------------------------------------------
# Cluster superuser, used only to bootstrap the database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
# Least-privileged role n8n actually connects with.
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=

# --- Deployment ---------------------------------------------------------
# Public hostname served by the external reverse proxy. No scheme, no slash,
# and no port: the public port is 443, which https:// already implies.
# N8N_EDITOR_BASE_URL and WEBHOOK_URL are derived from it in docker-compose.yml.
N8N_HOST=workflow.heuzef.com
GENERIC_TIMEZONE=Europe/Paris

# --- Ollama -------------------------------------------------------------
# Unauthenticated API on the private network. Never expose publicly.
OLLAMA_BASE_URL=http://192.168.0.106:11434

# --- Optional overrides (defaults live in docker-compose.yml) -----------
# LAN address n8n is published on, where Caddy reaches it. Change it if the
# VM's IP changes; 0.0.0.0 would also expose n8n outside the reverse proxy.
# N8N_BIND_ADDRESS=192.168.0.107
# N8N_VERSION=2.38.6
# N8N_LOG_LEVEL=info
# EXECUTIONS_TIMEOUT=3600
# EXECUTIONS_TIMEOUT_MAX=7200
# EXECUTIONS_DATA_MAX_AGE=336
